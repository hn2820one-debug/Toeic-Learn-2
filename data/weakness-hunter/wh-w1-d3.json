    "cards": [
      {
        "type": "formula",
        "tone": "verb",
        "title": "形容詞觸發公式",
        "html": "It is essential / mandatory / vital / necessary that + S + <span class=\"blank-word verb\">V 原形 / be</span>"
      },
      {
        "type": "warning",
        "tone": "warn",
        "title": "be 原形陷阱",
        "html": "that 後如果答案是 be 動詞，正式考點常要求 <span class=\"blank-word verb\">be</span>，不是 is / are / was。"
      }
    ]
  },
  "questions": [
    {
      "q_id": "wh-w1-d3-q1",
      "type": "main",
      "scene": "Aviation / Safety",
      "eye_distance": "middle",
      "target_pos": "verb",
      "weakness_tag": "mandative-adjective",
      "stem": "It is essential that all safety reports {BLANK} submitted before the aircraft is released.",
      "options": [
        { "label": "A", "text": "are", "pos": "verb", "is_correct": false },
        { "label": "B", "text": "were", "pos": "verb", "is_correct": false },
        { "label": "C", "text": "be", "pos": "verb", "is_correct": true },
        { "label": "D", "text": "being", "pos": "verb", "is_correct": false }
      ],
      "answer": "C",
      "hint": "It is essential that + S + ______",
      "solution_steps": [
        { "step": 1, "text": "essential that 是形容詞觸發器。" },
        { "step": 2, "text": "that 子句中 be 動詞用原形 be。" },
        { "step": 3, "text": "be submitted 是正確被動形式。" }
      ],
      "wrong_thought_steps": [
        "看到 reports 複數就選 are。",
        "忘記 essential that 會要求 be 原形。"
      ],
      "rule_box": {
        "type": "ok",
        "text": "It is essential that + S + be / V 原形。"
      }
    },
    {
