  "concept": {
    "debug_rule": "名詞前、be/seem/remain/become 後補語位要形容詞；-ful / -ous / -ive / -al / -able 常見形容詞語尾。",
    "cards": [
      {
        "type": "formula",
        "tone": "adj",
        "title": "形容詞語尾",
        "html": "-ful / -ous / -ive / -al / -able / -ible / -ary / -ory -> <span class=\"blank-word adj\">形容詞</span>"
      },
      {
        "type": "formula",
        "tone": "adj",
        "title": "形容詞位置",
        "html": "<span class=\"blank-word adj\">形容詞</span> + 名詞；be / seem / remain + <span class=\"blank-word adj\">形容詞</span>"
      },
      {
        "type": "warning",
        "tone": "warn",
        "title": "False Friend",
        "html": "economic = 經濟的；economical = 節儉的。兩者都係形容詞，但意思唔同。"
      }
    ]
  },
