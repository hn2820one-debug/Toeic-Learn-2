      "answer": "A",
      "hint": "conducted a customer + ______",
      "solution_steps": [
        { "step": 1, "text": "a customer 後面需要名詞。" },
        { "step": 2, "text": "conduct a survey 是 TOEIC 高頻搭配。" }
      ],
      "wrong_thought_steps": ["看到 conducted 是動作，誤判空格也要動詞。"],
      "rule_box": { "type": "ok", "text": "conduct a survey = 進行調查。" }
