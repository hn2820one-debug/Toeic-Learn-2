  "concept": {
    "debug_rule": "TOEIC 不只考單字詞性，常考整組搭配：make a decision、conduct a survey、submit a report。",
    "cards": [
      {
        "type": "formula",
        "tone": "noun",
        "title": "名詞搭配",
        "html": "<span class=\"blank-word verb\">make / reach / conduct / submit</span> + <span class=\"blank-word noun\">名詞</span>，整組記憶，不逐字翻譯。"
      },
      {
        "type": "warning",
        "tone": "warn",
        "title": "常見錯誤",
        "html": "不要把中文「做決定」直譯成 do a decision；正式英文用 make a decision。"
      }
    ]
  },
  "questions": [
    {
      "q_id": "pos-d5-q1",
      "type": "main",
      "scene": "Office / Management",
      "eye_distance": "near",
      "target_pos": "noun",
      "weakness_tag": "collocation-noun-verb",
      "stem": "The committee will make a final {BLANK} after reviewing the budget proposal.",
      "options": [
        { "label": "A", "text": "decide", "pos": "verb", "is_correct": false },
        { "label": "B", "text": "decision", "pos": "noun", "is_correct": true },
        { "label": "C", "text": "decisive", "pos": "adj", "is_correct": false },
        { "label": "D", "text": "decisively", "pos": "adv", "is_correct": false }
      ],
      "answer": "B",
      "hint": "make a final + ______",
      "solution_steps": [
        { "step": 1, "text": "make a final 後面需要名詞。" },
        { "step": 2, "text": "make a decision 是固定搭配。" }
      ],
      "wrong_thought_steps": ["看到 will make 誤以為空格也要動詞。"],
      "rule_box": { "type": "ok", "text": "make a decision，不用 do a decision 或 make decide。" }
    },
    {
      "q_id": "pos-d5-q2",
      "type": "main",
      "scene": "Marketing / Research",
      "eye_distance": "middle",
      "target_pos": "noun",
      "weakness_tag": "collocation-noun-verb",
      "stem": "The marketing team conducted a customer {BLANK} before launching the campaign.",
