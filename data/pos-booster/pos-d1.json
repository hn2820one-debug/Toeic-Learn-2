  "concept": {
    "debug_rule": "看到 the / a / this / our / any 或介系詞後空格，先判斷名詞位，再用 -tion / -ment / -ance 等語尾確認。",
    "cards": [
      {
        "type": "formula",
        "tone": "noun",
        "title": "名詞語尾",
        "html": "-tion / -ment / -ance / -ence / -ity / -ness / -ship / -hood -> <span class=\"blank-word noun\">名詞</span>"
      },
      {
        "type": "formula",
        "tone": "noun",
        "title": "位置法",
        "html": "限定詞 + <span class=\"blank-word noun\">名詞</span>；介系詞 + <span class=\"blank-word noun\">名詞</span>"
      },
      {
        "type": "warning",
        "tone": "warn",
        "title": "常見錯誤",
        "html": "看到熟悉動詞就先選，忽略空格其實係名詞位置。"
      }
    ]
  },
