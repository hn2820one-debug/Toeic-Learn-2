  "concept": {
    "debug_rule": "副詞修飾動詞、形容詞、副詞或整句；但 friendly / lovely / timely / likely / lonely 是常見 -ly 形容詞例外。",
    "cards": [
      {
        "type": "formula",
        "tone": "adv",
        "title": "副詞位置",
        "html": "動詞 + <span class=\"blank-word adv\">副詞</span>；副詞 + 形容詞；句首副詞 + 逗號"
      },
      {
        "type": "exception",
        "tone": "warn",
        "title": "-ly 例外",
        "html": "friendly / lovely / timely / likely / lonely 多數係 <span class=\"blank-word adj\">形容詞</span>。"
      },
      {
        "type": "warning",
        "tone": "warn",
        "title": "常見錯誤",
        "html": "見到 -ly 就直接選，但空格後如果接名詞，可能需要形容詞。"
      }
    ]
  },
